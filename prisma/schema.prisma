// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bed {
  id         String   @id
  bedNumber  String
  roomNumber String
  bedType    String
  occupied   Boolean
  isActive   Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Doctor {
  id        String   @id
  name      String
  specialization String
  phone     String
  email     String
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id        String   @id
  name      String
  phoneNum  String
  status    String
  bedId     String
  doctorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
